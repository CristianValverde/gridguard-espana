# .env.example — Copiar a .env y completar con valores reales.
# NUNCA incluir valores reales en el repo.

# APIs de datos de red eléctrica
ESIOS_TOKEN=your_token_here           # Solicitar en consultasios@ree.es
AEMET_API_KEY=your_key_here           # opendata.aemet.es → "Mis APIs"
ENTSOE_TOKEN=your_token_here          # transparency.entsoe.eu → "My Account"

# API de modelos Gemini
GOOGLE_API_KEY=your_gemini_key_here   # aistudio.google.com → "Get API Key"

# Rutas de almacenamiento local
DB_PATH=./data/gridguard.db
CHROMA_DB_PATH=./knowledge/chroma_db
ML_MODELS_PATH=./ml/models
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed
REPORTS_PATH=./reports

# Umbrales de riesgo (P(blackout_1h))
RISK_ALERT_THRESHOLD=0.30             # WARNING — análisis profundo
RISK_CRITICAL_THRESHOLD=0.60          # CRITICAL — todas las capas activadas

# Sistema
LOG_LEVEL=INFO
